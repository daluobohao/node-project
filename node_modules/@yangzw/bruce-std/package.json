{
  "name": "@yangzw/bruce-std",
  "version": "2.0.0",
  "license": "MIT",
  "description": "A VSCode configuration tool with integrated code verification",
  "keywords": [
    "bruce-std",
    "std",
    "beautify",
    "format",
    "lint",
    "rule",
    "standard",
    "vscode",
    "editorconfig",
    "eslint",
    "markdownlint",
    "prettier",
    "stylelint",
    "tslint",
    "typescript-eslint"
  ],
  "author": {
    "name": "JowayYoung",
    "email": "young.joway@outlook.com"
  },
  "homepage": "https://github.com/JowayYoung",
  "repository": {
    "type": "git",
    "url": "https://github.com/JowayYoung/bruce.git"
  },
  "bugs": {
    "email": "young.joway@outlook.com",
    "url": "https://github.com/JowayYoung/bruce/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/export.d.ts",
      "development": "./src/export.ts",
      "import": "./dist/export.js",
      "default": "./dist/export.js"
    },
    "./eslint": {
      "types": "./dist/eslint.d.ts",
      "development": "./src/configs/eslint.ts",
      "import": "./dist/eslint.js",
      "default": "./dist/eslint.js"
    },
    "./prettier": {
      "types": "./dist/prettier.d.ts",
      "development": "./src/configs/prettier.ts",
      "import": "./dist/prettier.js",
      "default": "./dist/prettier.js"
    },
    "./stylelint": {
      "types": "./dist/stylelint.d.ts",
      "development": "./src/configs/stylelint.ts",
      "import": "./dist/stylelint.js",
      "default": "./dist/stylelint.js"
    }
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.5.1"
  },
  "bin": {
    "bruce-std": "dist/index.js"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "chalk": "6.0.0",
    "commander": "15.0.0",
    "eslint": "10.8.1",
    "eslint-config-love": "155.0.0",
    "eslint-plugin-html": "8.1.4",
    "eslint-plugin-perfectionist": "5.10.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sort-properties": "1.1.13",
    "eslint-plugin-vue": "10.10.0",
    "figures": "6.1.0",
    "globals": "17.11.0",
    "jsonc-parser": "3.3.1",
    "ora": "9.4.1",
    "postcss": "8.5.26",
    "postcss-html": "2.0.0",
    "postcss-less": "6.0.0",
    "postcss-scss": "4.0.9",
    "prettier": "3.9.6",
    "semver": "7.8.5",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-order": "8.1.1",
    "stylelint-prettier": "5.0.3",
    "typescript-eslint": "8.67.0",
    "vue-eslint-parser": "10.4.1",
    "@yangzw/bruce-us": "2.0.0"
  },
  "devDependencies": {
    "@types/eslint": "9.6.1",
    "@types/node": "26.2.0",
    "@types/semver": "7.8.0",
    "tsup": "8.5.1",
    "typescript": "6.0.3"
  },
  "files": [
    "dist",
    ".markdownlint.json",
    ".prettierignore"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run check && tsup",
    "check": "tsc --noEmit",
    "dev": "tsup --watch",
    "link": "pnpm ln -g"
  }
}